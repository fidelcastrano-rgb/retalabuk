# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"


# Zoho Mail SMTP Configuration (for sending customer & admin order notifications)
# ZOHO_USER: Your Zoho Mail address (e.g. sales@reta-lab.co.uk or youraccount@zohomail.com)
ZOHO_USER="sales@reta-lab.co.uk"
# ZOHO_PASSWORD: Zoho application-specific password (generate in Zoho Account Security -> App Passwords)
ZOHO_PASSWORD=
# ZOHO_HOST: (Optional) Defaults to smtppro.zoho.com (or smtp.zoho.com / smtp.zoho.eu)
ZOHO_HOST="smtppro.zoho.com"
# ZOHO_PORT: (Optional) 465 (SSL default) or 587 (TLS)
ZOHO_PORT="465"

# ADMIN_EMAIL: Admin email address to receive order notifications
ADMIN_EMAIL="yamahaoutboardss@gmail.com"

# BACHS_SECRET_KEY: Secret live key for Bachs credit card payment gateway
BACHS_SECRET_KEY=

